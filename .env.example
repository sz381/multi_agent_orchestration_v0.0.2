# model config
DEEPSEEK_API_KEY="your_api_key"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_FALLBACK_MODEL="deepseek-v4-flash"
# tavily
TAVILY_API_KEY=your-tavily-api-key
# 用于长网页提炼的轻量模型 配置
WEB_FETCH_SUMMARIZE_MODEL="deepseek-v4-flash"
WEB_FETCH_SUMMARIZE_MODEL_API_KEY=sk-your-key
WEB_FETCH_SUMMARIZE_MODEL_BASE_URL=your-selected-model-base-url
# 用于聚合的模型 配置
PRE_AGGREGATION_MODEL="deepseek-v4-flash"
PRE_AGGREGATION_MODEL_API_KEY=sk-your-key
PRE_AGGREGATION_MODEL_BASE_URL=your-selected-model-base-url
# workspace config
WORKSPACE_DIR="your-workspace-dir"
# langsmith services
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<your_api_key>
LANGSMITH_PROJECT="Mr Orchestra"